<sitemesh>

    <!-- Khai bao Decorator Prefix de Sitemesh tu dong tim file layout trong thu muc /decorators/ theo yeu cau cua thay -->
    <decorator-prefix>/decorators/</decorator-prefix>

    <!-- Khai bao Decorator cho giao dien Web chung (/*) va Admin (/admin/*) -->
    <mapping path="/*" name="web" decorator="web.jsp" />
    <mapping path="/admin/*" name="admin" decorator="admin.jsp" />

    <!-- Exclude path from decoration theo dung yeu cau Buoc 3 cua thay -->
    <mapping path="/api*" exclude="true" />

</sitemesh>
